AEM_URL=http://localhost:4502
AEM_USERNAME=admin
AEM_PASSWORD=replace-me
# Alternatively use AEM_TOKEN instead of username/password.
# AEM_TOKEN=
# Restrict which repository roots tools may read (comma separated).
AEM_ALLOWED_ROOTS=/content
# Defaults to local; existing local configuration needs no changes.
AEM_ENV=local
# For AEM as a Cloud Service use:
# AEM_ENV=cloud
# AEM_URL=https://author-p12345-e67890.adobeaemcloud.com
# AEM_TOKEN_FILE=/absolute/path/to/.secrets/aem-local-token.json
# Token file takes precedence over AEM_TOKEN and username/password.
# Replace its contents with a new raw token or downloaded {"accessToken":"..."}
# JSON when the local development token expires. No MCP restart needed.
